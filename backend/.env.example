# ======== 应用 ========
APP_NAME=RAG Assistant
APP_ENV=dev
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ======== PostgreSQL ========
# 本地 Windows 安装 PG 后，在 psql 里执行：
#   CREATE USER rag_user WITH PASSWORD 'rag_pass';
#   CREATE DATABASE rag_db OWNER rag_user;
DATABASE_URL=postgresql+asyncpg://rag_user:rag_pass@localhost:5432/rag_db

# ======== Redis / Celery（本地 Memurai 默认端口 6379）========
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ======== Qdrant ========
# local = Python 内嵌模式（文件存储，单进程）
# remote = 远程 Qdrant 服务（生产环境）
QDRANT_MODE=local
QDRANT_LOCAL_PATH=./data/qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ======== Embedding（双通道：dashscope / local_bge）========
EMBEDDING_PROVIDER=dashscope
# 阿里云 DashScope: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-替换成你的key
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
# 本地 bge-m3（首次自动从 HuggingFace 下载 ~2GB）
LOCAL_BGE_MODEL_PATH=BAAI/bge-m3

# ======== LLM ========
# deepseek / openai / qwen / kimi / 其他 OpenAI 兼容
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-替换成你的key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ======== Reranker ========
RERANK_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=5

# ======== Retrieval ========
RETRIEVE_TOP_K=20
CHUNK_SIZE=512
CHUNK_OVERLAP=50
USE_HYDE=false

# ======== 上传 ========
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=.pdf,.docx,.md,.txt,.html

# ======== 入库模式 ========
# sync   = API 进程内 BackgroundTasks（不依赖 Celery，本地开发推荐）
# celery = 提交到 Celery Worker（生产用，要求 QDRANT_MODE=remote）
INGEST_MODE=sync

# ======== 企业微信（v2）========
WECOM_ENABLED=false
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_DEFAULT_KB_ID=
