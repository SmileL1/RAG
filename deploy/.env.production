# 生产环境配置模板
# 使用：cp .env.production.example .env.production，填写后启动
# 启动：docker compose --env-file .env.production up -d

# ======== 应用 ========
APP_NAME=RAG Assistant
APP_ENV=prod
DEBUG=false
API_PORT=8000

# 允许访问的前端域名（多个用逗号分隔）
CORS_ORIGINS=http://your-server-ip,http://your-domain.com

# ======== 安全（必改！）========
JWT_SECRET=11223344
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ======== PostgreSQL（容器内部地址）========
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=admin123
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rag_user:请设置强密码@postgres:5432/rag_db

# ======== Redis ========
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ======== Qdrant（容器间访问）========
QDRANT_MODE=remote
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# ======== 入库模式 ========
# sync   = API 进程内 BackgroundTasks，简单部署，无需启动 worker 服务
# celery = 独立 Worker 进程，需同时启动 worker 服务（稳定性更好）
INGEST_MODE=sync

# ======== Embedding   local_bge本地模型/dashscope阿里云========
EMBEDDING_PROVIDER=ocal_bge
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
# 本地模型路径（容器内挂载缓存卷时生效）
LOCAL_BGE_MODEL_PATH=BAAI/bge-m3

# ======== LLM ========
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=your_api_key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ======== Reranker ========
RERANK_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=5

# ======== Retrieval ========
RETRIEVE_TOP_K=20
CHUNK_SIZE=512
CHUNK_OVERLAP=50
USE_HYDE=false

# ======== 上传 ========
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=.pdf,.docx,.md,.txt,.html

# ======== HuggingFace 镜像（国内服务器必填）========
HF_ENDPOINT=https://hf-mirror.com
