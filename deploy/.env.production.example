# 生产环境配置模板
# 使用：cp .env.production.example .env.production，填写后启动
# 启动：docker compose --env-file .env.production up -d

# ======== 应用 ========
APP_NAME=RAG Assistant
APP_ENV=prod
DEBUG=false
API_PORT=8000

# 允许访问的前端域名（多个用逗号分隔）
CORS_ORIGINS=http://your-server-ip,http://your-domain.com

# ======== 安全（必改！）========
JWT_SECRET=请替换为随机长字符串-至少32位
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请设置强密码

# ======== PostgreSQL（容器内部地址）========
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=请设置强密码
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rag_user:请设置强密码@postgres:5432/rag_db

# ======== Qdrant（容器间访问）========
QDRANT_MODE=remote
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# ======== 入库模式（sync 无需 Celery/Redis）========
INGEST_MODE=sync

# ======== Ollama 本地模型 ========
# 支持的小模型（按中文效果排序）：
#   qwen2.5:3b  —— 2GB，中文最佳，推荐
#   qwen2.5:1.5b —— 1GB，内存极紧时用
#   phi3.5      —— 2.2GB，英文/逻辑推理强
#   gemma2:2b   —— 1.6GB，综合均衡
OLLAMA_MODEL=qwen2.5:3b

# ======== Embedding ========
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
LOCAL_BGE_MODEL_PATH=BAAI/bge-m3

# ======== LLM（指向容器内 Ollama 服务）========
LLM_PROVIDER=ollama
LLM_API_BASE=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ======== Reranker ========
RERANK_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=5

# ======== Retrieval ========
RETRIEVE_TOP_K=20
CHUNK_SIZE=512
CHUNK_OVERLAP=50
USE_HYDE=false

# ======== 上传 ========
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=.pdf,.docx,.md,.txt,.html

# ======== HuggingFace 镜像（国内服务器必填）========
HF_ENDPOINT=https://hf-mirror.com
