# 生产环境配置模板（内网服务器部署用）
# 使用：cp .env.production.example .env.production，然后修改

# ======== 应用 ========
APP_ENV=prod
DEBUG=false
API_PORT=8000

# ======== PostgreSQL（容器内部地址）========
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=改成强密码
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rag_user:改成强密码@postgres:5432/rag_db

# ======== Redis ========
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ======== Qdrant（容器间访问）========
QDRANT_MODE=remote
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# ======== Embedding ========
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=
LOCAL_BGE_MODEL_PATH=BAAI/bge-m3

# ======== LLM ========
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ======== 其他（同 dev） ========
RERANK_ENABLED=true
RETRIEVE_TOP_K=20
CHUNK_SIZE=512
CHUNK_OVERLAP=50
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=100
